# ==============================================================================
# Apache Configuration for Single Page Application - The Cove Lakkidi
# Works on all Apache 2.2+, cPanel, Plesk, LiteSpeed, Shared & Dedicated Hosts
# ==============================================================================

# Prevent directory indexing
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# Follow symbolic links (often required by Apache for URL rewriting)
<IfModule mod_rewrite.c>
  Options +FollowSymLinks
  RewriteEngine On

  # Ensure index.html is served directly
  RewriteRule ^index\.html$ - [L]

  # Allow all existing files and directories to be served directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Never redirect static assets (CSS, JS, images, fonts) to index.html
  RewriteCond %{REQUEST_URI} \.(css|js|mjs|json|png|jpg|jpeg|gif|svg|ico|webp|avif|woff|woff2|ttf|otf|eot|map)$ [NC]
  RewriteRule ^ - [L]

  # Route all other web requests to index.html (SPA Fallback)
  RewriteRule ^(.*)$ index.html [L,QSA]
</IfModule>

# ------------------------------------------------------------------------------
# Explicit MIME Types for Web Assets & ES Modules
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType text/css                                  css
  AddType application/javascript                    js mjs
  AddType application/json                          json
  AddType image/svg+xml                             svg svgz
  AddType image/webp                                webp
  AddType image/avif                                avif
  AddType image/png                                 png
  AddType image/jpeg                                jpg jpeg
  AddType image/x-icon                              ico
  AddType font/woff2                                woff2
  AddType font/woff                                 woff
  AddType font/ttf                                  ttf
  AddType font/otf                                  otf
</IfModule>

# ------------------------------------------------------------------------------
# HTTP Headers & Caching Controls
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Enforce correct Content-Type response headers
  <FilesMatch "\.css$">
    Header set Content-Type "text/css; charset=utf-8"
  </FilesMatch>
  <FilesMatch "\.(js|mjs)$">
    Header set Content-Type "application/javascript; charset=utf-8"
  </FilesMatch>

  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Always revalidate index.html so users receive instant updates
  <FilesMatch "(index\.html|index\.htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Cache hashed production bundle files in /assets for 1 year
  <FilesMatch "\.(js|mjs|css|webp|png|jpg|jpeg|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------------
# Gzip Compression
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml font/woff2
</IfModule>
